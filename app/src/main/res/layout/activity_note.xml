<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tiêu đề màn hình -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm Ghi Chú"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Ô nhập ghi chú (hỗ trợ nhập nhiều dòng) -->
    <EditText
        android:id="@+id/edtGhiChu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="5"
        android:gravity="top|start"
        android:hint="Nhập nội dung ghi chú vào đây..."
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <!-- Nút lưu và trả kết quả về màn hình 2 -->
    <Button
        android:id="@+id/btnLuuGhiChu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu Ghi Chú" />

</LinearLayout>